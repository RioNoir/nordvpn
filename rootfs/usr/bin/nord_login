#!/usr/bin/with-contenv bash

DAEMON_LOG=/var/log/nordvpn/daemon.log

if ! iptables -L > /dev/null 2>&1; then
  echo "FATAL: iptables is not functional. Ensure your container config adds --cap-add=NET_ADMIN,NET_RAW" 1>&2
  # Null route rather than leaving traffic unprotected.
  ip route del default
  ip route del 0.0.0.0/1 > /dev/null 2>&1
  ip route add default via 127.0.0.1
  echo "--- Due to errors, routing has been disabled ---" 1>&2
  # Don't allow execution to proceed as traffic may not be protected. Don't exit either as
  # containers that expect to be behind the VPN will route through the normal network.
  while true; do
    sleep 3600
  done
fi

while [ ! -S /run/nordvpn/nordvpnd.sock ] ; do
  sleep 1
done

[[ -z "${TOKEN}" ]] && [[ -f "${TOKENFILE}" ]] && TOKEN="$(head -n 1 "${TOKENFILE}" | tr -d '[:space:]')"
if [[ -z ${TOKEN} ]]; then
  echo "No token set. Provide TOKEN or TOKENFILE." 1>&2
  exit 1
fi

# "nordvpn account" fails with "You're not logged in." when there is no session.
is_logged_in() {
  nordvpn account > /dev/null 2>&1
}

show_daemon_log() {
  if [[ -s ${DAEMON_LOG} ]]; then
    echo "----- last lines of ${DAEMON_LOG} -----" 1>&2
    tail -n 40 "${DAEMON_LOG}" 1>&2
    echo "---------------------------------------" 1>&2
  fi
}

# Since 6.0 logout keeps the token valid unless --revoke-token is passed
nordvpn logout > /dev/null 2>&1

# The daemon creates its socket before it is fully initialised, so the first
# calls can fail silently: verify the result and retry a few times.
for attempt in 1 2 3 4 5 6; do
  # Since 4.0 the login is refused until the analytics consent has been
  # answered. The NordVPN CLI does not print an error when this fails, so
  # print its output to make problems visible.
  analytics_out=$(nordvpn set analytics off 2>&1)

  # The piped "n" answers the consent prompt if it still shows up.
  login_out=$(echo "n" | nordvpn login --token "${TOKEN}" 2>&1 | grep -v -e '^$')

  if is_logged_in; then
    echo "Logged in to NordVPN."
    exit 0
  fi

  # A rejected token won't get better by retrying.
  if grep -qiE 'token.*(invalid|expired)|invalid.*token|expired' <<< "${login_out}"; then
    echo "Login failed: the token was rejected. Generate a new one in Nord Account." 1>&2
    echo "${login_out}" | tail -n 3 1>&2
    exit 1
  fi

  echo "Login attempt ${attempt} failed." 1>&2
  echo "  set analytics off: $(tail -n 1 <<< "${analytics_out:-<no output>}")" 1>&2
  echo "  login: $(tail -n 1 <<< "${login_out:-<no output>}")" 1>&2
  sleep $((attempt * 5))
done

echo "FATAL: unable to log in to NordVPN." 1>&2
show_daemon_log
exit 1
