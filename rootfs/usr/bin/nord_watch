#!/bin/bash

while true; do
  sleep "${CHECK_CONNECTION_INTERVAL:-300}"
  # VPN stopped on purpose through the control server API: don't reconnect
  [[ -f /run/nordvpn-control/stopped ]] && continue
  if [[ ! $(curl -Is -m 30 -o /dev/null -w "%{http_code}" "${CHECK_CONNECTION_URL:-www.google.com}") =~ ^[23] ]]; then
    echo "Unstable connection detected!"
    nordvpn status
    # s6-overlay v3 keeps services in /run/service, v2 used /var/run/s6/services
    service_dir=/run/service/nordvpn
    [[ -d ${service_dir} ]] || service_dir=/var/run/s6/services/nordvpn
    s6-svc -wR -t "${service_dir}"
    if ! nord_connect ; then
      echo "Unable to connect"
      exit 1
    fi
  fi
done

exit 0