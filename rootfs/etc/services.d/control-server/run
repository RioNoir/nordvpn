#!/usr/bin/with-contenv bash

# gluetun compatible HTTP control server, see README "Control server API".
# It only starts when an API key is configured.
if [[ -z ${CONTROL_API_KEY} && -z ${CONTROL_API_KEY_FILE} ]]; then
  echo "[control-server] disabled: set CONTROL_API_KEY to enable the API on port ${CONTROL_API_PORT:-8000}"
  s6-svc -O .   # run once: do not restart after this script exits
  exit 0
fi

exec /usr/bin/control-server
